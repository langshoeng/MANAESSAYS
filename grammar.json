  {
   "id": "p10",
   "group": "Verbs & tenses",
   "title": "Part 10 · Conditionals",
   "blocks": [
    {
     "t": "tbl",
     "head": [
      "Type",
      "Formula",
      "Meaning",
      "Example"
     ],
     "rows": [
      [
       "Zero",
       "If + present, present",
       "general truth",
       "If you heat ice, it melts."
      ],
      [
       "First",
       "If + present, will + V1",
       "real/possible future",
       "If I study, I will pass."
      ],
      [
       "Second",
       "If + past, would + V1",
       "unreal/unlikely present/future",
       "If I had time, I would study."
      ],
      [
       "Third",
       "If + had + V3, would have + V3",
       "unreal past/regret",
       "If I had studied, I would have passed."
      ],
      [
       "Mixed",
       "If + had + V3, would + V1",
       "past condition, present result",
       "If I had studied, I would know it now."
      ]
     ]
    },
    {
     "t": "ul",
     "items": [
      "Do not normally put will directly after if in the first conditional.",
      "Formal second conditional: If I were you, I would study.",
      "Unless = if not: Unless you study, you may fail."
     ]
    }
   ]
  },
