      [
       "every day / usually / always",
       "Present Simple",
       "She teaches every day."
      ],
      [
       "now / at the moment",
       "Present Continuous",
       "She is teaching now."
      ],
      [
       "yesterday / last year / ago",
       "Past Simple",
       "She taught yesterday."
      ],
      [
       "when + interruption",
       "Past Continuous + Past Simple",
       "She was teaching when he arrived."
      ],
      [
       "before + past event",
       "Past Perfect + Past Simple",
       "She had left before I arrived."
      ],
      [
       "since / for + continuing situation",
       "Present Perfect / Perfect Continuous",
       "She has lived here for five years."
      ],
      [
       "by + future time",
       "Future Perfect",
       "She will have finished by Friday."
      ]
     ]
    },
    {
     "t": "ul",
     "items": [
      "After does/doesn't/did/didn't, use V1: Does she teach? Did she go?",
      "After have/has/had in perfect tenses, use V3.",
      "After be in continuous tenses, use V-ing.",
      "Do not normally use Present Perfect with finished time words such as yesterday or last year."
     ]
    }
   ]
