  {
   "id": "start",
   "group": "Start here",
   "title": "How to use this handbook",
   "blocks": [
    {
     "t": "p",
     "x": "Use this as a revision guide: memorize the formula, understand the condition/use, learn the common signal words, then practice the examples."
    },
    {
     "t": "ul",
     "items": [
      "V1 = base form: go, study, teach",
      "V2 = past form: went, studied, taught",
      "V3 = past participle: gone, studied, taught",
      "V-ing = going, studying, teaching"
     ]
    }
   ]
  },
